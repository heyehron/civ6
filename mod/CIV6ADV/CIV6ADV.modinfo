<?xml version="1.0" encoding="utf-8"?>
<Mod id="5f3c2a9e-7d41-4b8a-9c6e-2a1b0d4e8f73" version="1">
  <Properties>
    <Name>Civ VI Achievement Advisor</Name>
    <Description>UI-only. Writes your game state to Lua.log for the Civ VI Achievement Advisor app. Does not change gameplay.</Description>
    <Teaser>State export for the achievement advisor</Teaser>
    <Authors>civ6advisor</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <InGameActions>
    <AddUserInterfaces id="CIV6ADV_UI">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>UI/CIV6ADV.xml</File>
    </AddUserInterfaces>
    <ImportFiles id="CIV6ADV_IMPORT">
      <File>UI/CIV6ADV.lua</File>
    </ImportFiles>
  </InGameActions>
  <Files>
    <File>UI/CIV6ADV.xml</File>
    <File>UI/CIV6ADV.lua</File>
  </Files>
</Mod>
